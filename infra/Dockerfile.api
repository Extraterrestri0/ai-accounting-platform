# syntax=docker/dockerfile:1
# ---- build ----
FROM node:20-alpine AS build
WORKDIR /app
COPY apps/api/package.json apps/api/package-lock.json* ./
RUN npm ci || npm install
COPY apps/api/ ./
RUN npm run build           # tsc -> dist/ (CommonJS)

# ---- runtime ----
FROM node:20-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
RUN addgroup -S app && adduser -S app -G app
COPY --from=build /app/package.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/db ./db
COPY --from=build /app/scripts ./scripts
RUN mkdir -p /var/lib/doc-storage RUN mkdir -p /var/lib/doc-storage && chown -R app:app /var/lib/doc-storageRUN mkdir -p /var/lib/doc-storage && chown -R app:app /var/lib/doc-storage touch /var/lib/doc-storage/.keep RUN mkdir -p /var/lib/doc-storage && chown -R app:app /var/lib/doc-storageRUN mkdir -p /var/lib/doc-storage && chown -R app:app /var/lib/doc-storage chown -R app:app /var/lib/doc-storage
USER app
EXPOSE 3000
# liveness/readiness handled by the orchestrator hitting /health/live and /health/ready
HEALTHCHECK --interval=30s --timeout=4s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/main.js"]
