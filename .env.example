# ===== Secrets & config — copy to .env (gitignored), fill real values. NEVER commit .env. =====
NODE_ENV=production
PORT=3000

# --- PostgreSQL ---
PGDATABASE=accounting
POSTGRES_SUPERUSER=app_owner
POSTGRES_SUPERUSER_PASSWORD=change-me-strong-owner-password
PGUSER=app_user                 # runtime role — RLS subject, NOT the owner
PGPASSWORD=change-me-strong-app-password
MIGRATION_USER=app_owner        # migrations run as the owner
MIGRATION_PASSWORD=change-me-strong-owner-password

# --- Auth ---
JWT_SECRET=change-me-to-a-32+char-random-secret
AUTH_JWT_SECRET=change-me-to-a-32+char-random-secret   # signs access tokens
AUTH_ACCESS_TTL=2h
REFRESH_TOKEN_DAYS=30

# --- Google OAuth (optional; leave blank to disable the button gracefully) ---
# Console steps: https://console.cloud.google.com/apis/credentials → Create OAuth client ID
#   App type: Web application
#   Authorized redirect URI: http://localhost:3000/auth/google/callback  (must match GOOGLE_REDIRECT_URI)
#   Authorized JavaScript origin: http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
WEB_APP_URL=http://localhost:3001                      # where the OAuth callback hands the SPA its token

# --- Redis / queues ---
REDIS_URL=redis://redis:6379

# --- Object storage (S3 in prod; MinIO locally) ---
STORAGE_DRIVER=s3               # 's3' (AWS/MinIO) or 'local' (dev disk only)
STORAGE_ENDPOINT=http://minio:9000   # omit for real AWS S3 (uses default endpoint)
STORAGE_BUCKET=documents
STORAGE_REGION=eu-central-1
STORAGE_ACCESS_KEY=change-me     # omit on AWS if using an IAM role
STORAGE_SECRET_KEY=change-me-strong
STORAGE_RETAIN_DAYS=3650         # WORM/Object-Lock retention on finalize

# --- Document pipeline ---
OCR_REAL=true                    # 'false' uses the dev stub (tests/preview only)
OCR_PROVIDER=default             # default | azure | http | stub  (selects the OCR/Document-AI adapter)
OCR_TIMEOUT_MS=30000             # per-document analyze/poll timeout
# Generic EU zero-retention vendor (OCR_PROVIDER=http, or images under 'default')
OCR_VENDOR_URL=                  # POST bytes -> { text, pageCount, fields?[] }
OCR_VENDOR_KEY=
# Azure AI Document Intelligence (OCR_PROVIDER=azure) — structured invoice fields, EU region required
AZURE_DOCINTEL_ENDPOINT=         # https://<resource>.cognitiveservices.azure.com
AZURE_DOCINTEL_KEY=
AZURE_DOCINTEL_REGION=westeurope # GDPR/EU: must be an approved EU region (guarded at startup)
AZURE_DOCINTEL_MODEL=prebuilt-invoice
AZURE_DOCINTEL_API_VERSION=2023-07-31
OCR_ALLOW_NON_EU=                # 'true' deliberately bypasses the EU-residency guard (NOT for production)
AV_SCAN_URL=                     # ClamAV/AV vendor endpoint; if unset the worker treats scans as clean (DEV ONLY)

# --- Invoice delivery (choose one; else dev log sender) ---
RESEND_API_KEY=                  # preferred if set
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@example.com

# --- Frontend → backend (build-time) ---
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_USE_MOCK=false
CORS_ORIGINS=http://localhost:8080

# --- Rate limiting ---
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=300
